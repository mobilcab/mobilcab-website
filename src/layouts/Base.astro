---
import '../styles/global.css';
import CtaTracking from '../components/CtaTracking.astro';
import Analytics from '@vercel/analytics/astro';
import fontLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import fontLatinExt from '@fontsource-variable/manrope/files/manrope-latin-ext-wght-normal.woff2?url';
import { PUBLIC_PLAUSIBLE_DOMAIN } from 'astro:env/client';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /**
   * The same page in every locale, for canonical, hreflang and share tags.
   * Omit for pages that shouldn't be indexed or shared (e.g. 404).
   */
  alternates?: Record<Lang, string>;
  /**
   * Languages the page really exists in, for hreflang. Defaults to all. A
   * Romanian-only blog post passes ['ro'], so its English "alternate" (the
   * English blog index) isn't announced as a translation.
   */
  translatedInto?: Lang[];
  /** schema.org objects (src/lib/structuredData.ts), only used on indexable pages. */
  structuredData?: Record<string, unknown>[];
}

const { lang, title, description, alternates, translatedInto, structuredData = [] } = Astro.props;
// "<" escaped so text in the data can never close the <script> element.
const jsonLd = (data: Record<string, unknown>) => JSON.stringify(data).replace(/</g, '\\u003c');
const site = Astro.site ?? new URL(Astro.url.origin);
const abs = (path: string) => new URL(path, site).href;
const canonical = alternates && abs(alternates[lang]);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Start the font download right away instead of after the CSS is parsed.
        English text only needs the Latin file; Romanian also needs Latin Extended. */}
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    {lang === 'ro' && <link rel="preload" href={fontLatinExt} as="font" type="font/woff2" crossorigin />}
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      alternates ? (
        <>
          <link rel="canonical" href={canonical} />
          {Object.entries(alternates)
            .filter(([l]) => !translatedInto || translatedInto.includes(l as Lang))
            .map(([l, path]) => (
              <link rel="alternate" hreflang={l} href={abs(path)} />
            ))}
          {(!translatedInto || translatedInto.includes('ro')) && <link rel="alternate" hreflang="x-default" href={abs(alternates.ro)} />}
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Mobilcab" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:locale" content={lang === 'ro' ? 'ro_RO' : 'en_GB'} />
          <meta property="og:locale:alternate" content={lang === 'ro' ? 'en_GB' : 'ro_RO'} />
          {/* Generated by `npm run og` from the headline in src/i18n/*.json */}
          <meta property="og:image" content={abs(`/og-${lang}.png`)} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={t.hero.headline} />
          <meta name="twitter:card" content="summary_large_image" />
          {structuredData.map((data) => (
            <script is:inline type="application/ld+json" set:html={jsonLd(data)} />
          ))}
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <meta name="theme-color" content="#f7f6f3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      PUBLIC_PLAUSIBLE_DOMAIN && (
        <script is:inline defer data-domain={PUBLIC_PLAUSIBLE_DOMAIN} src="https://plausible.io/js/script.js"></script>
      )
    }
  </head>
  <body class="blueprint min-h-dvh antialiased">
    <slot />
    <CtaTracking />
    {/* Page views on Vercel (Hobby free tier). Custom waitlist events stay on Plausible when configured. */}
    <Analytics />
  </body>
</html>
