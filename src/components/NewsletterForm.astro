---
import type { Dict, Lang } from '../i18n';

interface Props {
  lang: Lang;
  t: Dict;
  privacyHref: string;
}

const { lang, t, privacyHref } = Astro.props;
---

<div data-newsletter data-lang={lang} data-messages={JSON.stringify(t.messages)}>
  <form class="space-y-4" novalidate>
    <div class="flex flex-col gap-3 sm:flex-row">
      <label for="newsletter-email" class="sr-only">{t.form.emailLabel}</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        maxlength="254"
        required
        placeholder={t.form.emailPlaceholder}
        class="min-h-12 w-full flex-1 rounded-md border border-line bg-white px-4 text-base text-ink placeholder:text-graphite/60 focus:border-wood focus:ring-2 focus:ring-wood/25 focus:outline-none aria-[invalid=true]:border-red-700"
      />
      <button
        type="submit"
        class="min-h-12 rounded-md bg-wood px-5 text-base font-semibold text-white transition-colors hover:bg-wood-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-wood disabled:cursor-wait disabled:opacity-70"
      >
        {t.form.submit}
      </button>
    </div>

    <label class="flex items-start gap-3 text-sm leading-snug text-graphite">
      <input type="checkbox" name="consent" required class="mt-0.5 size-5 shrink-0 accent-wood" />
      <span>
        {t.form.consent}{' '}
        <a href={privacyHref} class="text-ink underline underline-offset-2 hover:text-wood-dark">{t.form.privacyLink}</a>
      </span>
    </label>

    <div class="honeypot" aria-hidden="true">
      <label>
        Company
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <p data-status role="status" aria-live="polite" class="min-h-5 text-sm font-medium text-red-800"></p>
  </form>

  <div data-success hidden tabindex="-1" class="rounded-md border border-line bg-white px-5 py-4 outline-none">
    <p data-success-text class="text-base font-medium text-ink"></p>
  </div>
</div>

<script>
  import { isValidEmail, normalizeEmail } from '../lib/email';

  type MessageKey = 'sending' | 'pending' | 'invalidEmail' | 'consentRequired' | 'network' | 'server';
  type Plausible = (event: string, options?: { props?: Record<string, string> }) => void;

  for (const root of document.querySelectorAll<HTMLElement>('[data-newsletter]')) {
    const form = root.querySelector('form')!;
    const emailInput = form.elements.namedItem('email') as HTMLInputElement;
    const consentInput = form.elements.namedItem('consent') as HTMLInputElement;
    const honeypot = form.elements.namedItem('company') as HTMLInputElement;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const successText = root.querySelector<HTMLElement>('[data-success-text]')!;
    const lang = root.dataset.lang ?? 'ro';
    const messages: Record<MessageKey, string> = JSON.parse(root.dataset.messages ?? '{}');
    const buttonLabel = button.textContent;

    const setError = (message: string, field?: HTMLInputElement) => {
      status.textContent = message;
      emailInput.removeAttribute('aria-invalid');
      consentInput.removeAttribute('aria-invalid');
      if (field) {
        field.setAttribute('aria-invalid', 'true');
        field.focus();
      }
    };

    const showDone = (message: string) => {
      successText.textContent = message;
      form.hidden = true;
      success.hidden = false;
      success.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const email = normalizeEmail(emailInput.value);
      if (!isValidEmail(email)) return setError(messages.invalidEmail, emailInput);
      if (!consentInput.checked) return setError(messages.consentRequired, consentInput);

      setError('');
      button.disabled = true;
      button.textContent = messages.sending;

      try {
        // Neon marketing-consent (source: web). Confirm lands on Functions HTML, not /confirmat/.
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, consent: true, lang, company: honeypot.value }),
          signal: AbortSignal.timeout(15000),
        });
        const data: { status?: string; error?: string } = await res.json().catch(() => ({}));

        if (res.ok && data.status === 'pending') {
          (window as unknown as { plausible?: Plausible }).plausible?.('Newsletter Signup', {
            props: { lang },
          });
          showDone(messages.pending);
          return;
        }
        if (data.error === 'invalid_email') return setError(messages.invalidEmail, emailInput);
        if (data.error === 'consent_required') return setError(messages.consentRequired, consentInput);
        setError(messages.server);
      } catch {
        setError(messages.network);
      } finally {
        button.disabled = false;
        button.textContent = buttonLabel;
      }
    });
  }
</script>
