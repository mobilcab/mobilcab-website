---
// Renders copy that may mention M1/M2/M3 as roadmap links + title tooltips.
import type { Lang } from '../i18n';
import { linkMilestones } from '../lib/milestones';

interface Props {
  text: string;
  lang: Lang;
  as?: 'p' | 'span' | 'h1' | 'h2' | 'h3' | 'li' | 'div';
  class?: string;
}

const { text, lang, as: Tag = 'p', class: className } = Astro.props;
---

<Tag class={className} set:html={linkMilestones(text, lang)} />
