---
// Product roadmap for workshops: what ships, in what order, without fake dates.
import Base from '../layouts/Base.astro';
import PreviewBanner from './PreviewBanner.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { APP_URL } from '../config';
import { useRoadmapTranslations, type Lang } from '../i18n';
import { joinFreeHref as joinFree, pathsFor, published } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const preview = !published.roadmap;
const t = useRoadmapTranslations(lang);
const paths = pathsFor('roadmap');
const joinFreeHref = joinFree(lang, preview);
const wrap = 'mx-auto w-full max-w-5xl px-5 sm:px-8';

type StatusKey = keyof typeof t.statuses;
const statusClass = (status: StatusKey) => {
  if (status === 'available' || status === 'launch') return 'border-wood/40 bg-wood/10 text-wood-dark';
  if (status === 'inProgress') return 'border-line bg-white text-ink';
  return 'border-line bg-paper text-graphite';
};
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} alternates={preview ? undefined : paths}>
  {preview && <PreviewBanner lang={lang} />}

  <div class={wrap}>
    <SiteHeader lang={lang} alternates={paths} preview={preview} current="roadmap" />
  </div>

  <main>
    <section class:list={[wrap, 'pt-10 pb-10 sm:pt-16 sm:pb-14']}>
      <div class="max-w-2xl">
        <div class="dimension-line mb-6" aria-hidden="true"></div>
        <p class="text-sm font-semibold tracking-wide text-wood">{t.hero.label}</p>
        <h1 class="mt-3 text-[2rem] leading-[1.12] font-bold tracking-tight text-balance sm:text-[3rem]">{t.hero.title}</h1>
        <p class="mt-5 text-lg leading-relaxed text-graphite">{t.hero.body}</p>
      </div>
    </section>

    <section class="border-t border-line bg-white/60" aria-labelledby="roadmap-stages">
      <div class:list={[wrap, 'py-10 sm:py-14']}>
        <h2 id="roadmap-stages" class="sr-only">{lang === 'ro' ? 'Etapele' : 'Stages'}</h2>
        <ol class="relative max-w-2xl">
          {
            t.stages.map((stage, i) => {
              const status = stage.status as StatusKey;
              const last = i === t.stages.length - 1;
              return (
                <li class="relative flex gap-5 pb-10 last:pb-0 sm:gap-8 sm:pb-12">
                  {!last && (
                    <span
                      class="absolute top-10 bottom-0 left-[1.125rem] w-px bg-line sm:left-[1.375rem]"
                      aria-hidden="true"
                    />
                  )}
                  <div class="relative z-10 flex size-9 shrink-0 items-center justify-center rounded-full border border-line bg-paper text-sm font-bold text-ink sm:size-11 sm:text-base">
                    {i + 1}
                  </div>
                  <div class="min-w-0 flex-1 pt-0.5 sm:pt-1.5">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                      <h3 class="text-lg leading-snug font-bold tracking-tight text-ink sm:text-xl">{stage.title}</h3>
                      <span
                        class:list={[
                          'inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold tracking-wide',
                          statusClass(status),
                        ]}
                      >
                        {t.statuses[status]}
                      </span>
                    </div>
                    <p class="mt-2 text-base leading-relaxed text-graphite sm:mt-3">{stage.body}</p>
                  </div>
                </li>
              );
            })
          }
        </ol>
      </div>
    </section>

    <section class="border-t border-line" aria-labelledby="roadmap-faq">
      <div class:list={[wrap, 'py-10 sm:py-14']}>
        <h2 id="roadmap-faq" class="text-[1.625rem] leading-tight font-bold tracking-tight sm:text-[2rem]">{t.faq.title}</h2>
        <div class="mt-8 max-w-2xl divide-y divide-line border-y border-line">
          {
            t.faq.items.map((item) => (
              <details id={item.id} class="group scroll-mt-4 py-1">
                <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                  {item.q}
                  <span class="text-2xl font-normal text-wood transition-transform group-open:rotate-45" aria-hidden="true">
                    +
                  </span>
                </summary>
                <div class="space-y-3 pb-5 text-base leading-relaxed text-graphite">
                  {item.a.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-t border-line bg-white/60">
      <div class:list={[wrap, 'py-14 sm:py-20']}>
        <div class="max-w-2xl">
          <h2 class="text-[1.625rem] leading-tight font-bold tracking-tight sm:text-[2rem]">{t.cta.title}</h2>
          <p class="mt-3 text-base leading-relaxed text-graphite">{t.cta.body}</p>
          <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-6">
            <a
              href={APP_URL}
              class="btn-primary"
              data-cta="try_app"
              data-cta-location="roadmap"
              rel="noopener"
            >
              {t.cta.primary}
            </a>
            <a href={joinFreeHref} class="link-quiet" data-cta="join_free" data-cta-location="roadmap">
              {t.cta.secondary}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} preview={preview} />
</Base>
