---
// Blog / Resources index (Build Brief 4.5). Lists the posts in
// src/content/blog/. The English page also lists the Romanian posts, since the
// SEO articles target Romanian searches.
import Base from '../layouts/Base.astro';
import PreviewBanner from './PreviewBanner.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { isPostPublic, postPath, postsToList } from '../lib/blog';
import { useBlogTranslations, type Lang } from '../i18n';
import { pathsFor, published } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const preview = !published.blog;
const t = useBlogTranslations(lang);
const paths = pathsFor('blog');
const own = postsToList(lang, preview);
const romanian = lang === 'en' ? postsToList('ro', preview) : [];
const groups = [
  { posts: own, note: '', postLang: lang },
  { posts: romanian, note: t.langNote, postLang: 'ro' as Lang },
].filter((g) => g.posts.length > 0);
const formatDate = (date: Date, l: Lang) =>
  new Intl.DateTimeFormat(l === 'ro' ? 'ro-RO' : 'en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(date);
const wrap = 'mx-auto w-full max-w-5xl px-5 sm:px-8';
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} alternates={preview ? undefined : paths}>
  {preview && <PreviewBanner lang={lang} />}

  <div class={wrap}>
    <SiteHeader lang={lang} alternates={paths} preview={preview} current="blog" />
  </div>

  <main>
    <section class:list={[wrap, 'pt-10 pb-10 sm:pt-16 sm:pb-14']}>
      <div class="max-w-2xl">
        <div class="dimension-line mb-6" aria-hidden="true"></div>
        <p class="text-sm font-semibold tracking-wide text-wood">{t.hero.label}</p>
        <h1 class="mt-3 text-[2rem] leading-[1.12] font-bold tracking-tight text-balance sm:text-[3rem]">{t.hero.title}</h1>
        <p class="mt-5 text-lg leading-relaxed text-graphite">{t.hero.body}</p>
      </div>
    </section>

    <section class="border-t border-line bg-white/60">
      <div class:list={[wrap, 'py-10 sm:py-14']}>
        {groups.length === 0 && <p class="text-base text-graphite">{t.empty}</p>}
        {
          groups.map((group) => (
            <div class="mb-10 last:mb-0">
              {group.note && <p class="mb-5 max-w-2xl text-sm font-medium text-graphite">{group.note}</p>}
              <ul class="grid gap-4 md:grid-cols-3">
                {group.posts.map((post) => (
                  <li class="flex flex-col rounded-md border border-line bg-white p-5" lang={group.postLang}>
                    {!isPostPublic(post) && (
                      <p class="mb-3 self-start rounded-full bg-paper px-2.5 py-0.5 text-xs font-semibold text-wood">{t.draft}</p>
                    )}
                    <p class="text-xs font-medium text-graphite">
                      <time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date, post.lang)}</time>
                    </p>
                    <h2 class="mt-2 text-lg leading-snug font-bold tracking-tight">
                      <a href={postPath(post)} class="hover:text-wood-dark">
                        {post.title}
                      </a>
                    </h2>
                    <p class="mt-2 text-sm leading-relaxed text-graphite">{post.description}</p>
                    <a href={postPath(post)} class="link-quiet mt-auto pt-3 text-sm" aria-hidden="true" tabindex="-1">
                      {t.readMore}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} preview={preview} />
</Base>
