---
// Phase 2 Home page (Build Brief 4.1, copy from Launch Content Kit Section 1).
// Hero → Problem → Features → Demo → Pricing teaser → FAQ teaser → Final CTA.
// The social-proof section is deliberately absent until real testimonials exist (Funnel Plan 3.1).
import Base from '../layouts/Base.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import PreviewBanner from './PreviewBanner.astro';
import VideoPlayer from './VideoPlayer.astro';
import NewsletterForm from './NewsletterForm.astro';
import MilestoneText from './MilestoneText.astro';
import { APP_URL } from '../config';
import { demoVideos } from '../data/demoVideos';
import { useDemoTranslations, useHomeTranslations, useTranslations, type Lang } from '../i18n';
import { homeData, softwareData } from '../lib/structuredData';
import { linkFor, pathsFor, productPublic, published } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const preview = !published.home;
const t = useHomeTranslations(lang);
const formT = useTranslations(lang);
// Links to pages that aren't published are null on the public site and left out.
const fpHref = linkFor('foundingPartner', lang, preview);
const demoHref = linkFor('demo', lang, preview);
const pricingHref = linkFor('pricing', lang, preview);
const faqHref = linkFor('faq', lang, preview);
const privacyHref = linkFor('privacy', lang, preview) ?? '';
const demoT = useDemoTranslations(lang);
const site = Astro.site;
const structuredData = site
  ? [...homeData(site, lang), ...(productPublic ? [softwareData(site, lang, t.meta.description)] : [])]
  : [];
const joinId = t.anchors.join;
const wrap = 'mx-auto w-full max-w-5xl px-5 sm:px-8';
const sectionTitle = 'text-[1.625rem] leading-tight font-bold tracking-tight sm:text-[2rem]';
---

<Base
  lang={lang}
  title={t.meta.title}
  description={t.meta.description}
  alternates={preview ? undefined : pathsFor('home')}
  structuredData={structuredData}
>
  {preview && <PreviewBanner lang={lang} />}

  <main>
    {/* Hero: one plane; laptop dominates the right, never under text/nav */}
    <section class="relative isolate overflow-hidden border-b border-line">
      {/* Dominant laptop — right half, soft fade into grid (left + top) */}
      <div
        class="pointer-events-none absolute bottom-0 left-[42%] right-0 top-16 -z-10 hidden sm:block"
        aria-hidden="true"
      >
        <img
          src="/images/hero-laptop.jpg"
          alt=""
          width="1200"
          height="1000"
          class="h-full w-full object-cover object-[18%_48%] select-none"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        {/* Soft blend into the drafting grid — wide fade, no hard photo edge */}
        <div class="absolute inset-y-0 left-0 w-[55%] bg-gradient-to-r from-paper from-[5%] via-paper/65 via-[40%] to-transparent to-[95%]"></div>
        <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-paper from-[15%] via-paper/50 via-[55%] to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-paper/80 to-transparent"></div>
        <div class="absolute left-0 top-0 h-48 w-48 bg-[radial-gradient(ellipse_at_top_left,var(--color-paper)_10%,transparent_68%)]"></div>
      </div>
      <div class={wrap}>
        <SiteHeader lang={lang} alternates={pathsFor('home')} preview={preview} current="home" />
      </div>
      <div class:list={[wrap, 'relative grid items-center gap-10 pb-16 pt-6 sm:min-h-[min(70vh,42rem)] sm:grid-cols-2 sm:gap-8 sm:pb-24 sm:pt-8']}>
        <div class="relative z-10 max-w-xl">
          <div class="dimension-line mb-6" aria-hidden="true"></div>
          <h1 class="text-[2.125rem] leading-[1.1] font-bold tracking-tight text-balance sm:text-[3.25rem]">{t.hero.title}</h1>
          <p class="mt-5 text-lg leading-relaxed text-graphite">{t.hero.body}</p>
          <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-4">
            <a href={APP_URL} class="btn-primary" data-cta="open_app" data-cta-location="hero" rel="noopener">
              {t.hero.ctaPrimary}
            </a>
            {
              fpHref && (
                <a href={fpHref} class="btn-secondary" data-cta="founding_partner" data-cta-location="hero">
                  {t.hero.ctaSecondary}
                </a>
              )
            }
          </div>
        </div>
        {/* Mobile: show laptop under copy; desktop uses absolute right panel */}
        <div class="relative sm:invisible sm:min-h-[22rem]">
          <img
            src="/images/hero-laptop.jpg"
            alt={lang === 'ro' ? 'MobilCab pe laptop — proiect Nutu Living' : 'MobilCab on a laptop — Nutu Living project'}
            width="1200"
            height="1000"
            class="mx-auto h-auto w-full max-w-md select-none sm:absolute sm:inset-0 sm:max-w-none sm:opacity-0"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    {/* Problem */}
    <section class="border-t border-line bg-white/60">
      <div class:list={[wrap, 'py-14 sm:py-20']}>
        <h2 class={sectionTitle}>{t.problem.title}</h2>
        <ul class="mt-8 grid gap-x-10 gap-y-4 sm:grid-cols-2">
          {
            t.problem.items.map((item) => (
              <li class="flex gap-3 text-base leading-relaxed text-graphite">
                <span class="mt-[0.7em] h-px w-4 shrink-0 bg-wood" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* Features */}
    <section class="border-t border-line">
      <div class:list={[wrap, 'py-14 sm:py-20']}>
        <h2 class={sectionTitle}>{t.features.title}</h2>
        <ol class="mt-10 grid gap-x-12 gap-y-10 sm:grid-cols-2">
          {
            t.features.items.map((item, i) => (
              <li class="border-t border-wood/40 pt-5">
                <div class="flex items-baseline gap-3">
                  <span class="shrink-0 text-sm font-semibold tabular-nums text-wood">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="text-lg font-bold tracking-tight text-ink sm:text-xl">{item.title}</h3>
                </div>
                <MilestoneText text={item.body} lang={lang} class="mt-3 text-base leading-relaxed text-graphite sm:pl-9" />
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* Demo: video slots until the recordings exist (Launch Content Kit Section 2) */}
    <section class="border-t border-line bg-white/60" data-track-section="demo">
      <div class:list={[wrap, 'py-14 sm:py-20']}>
        <h2 class={sectionTitle}>{t.demo.title}</h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-graphite">{t.demo.intro}</p>
        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          {
            t.demo.videos.map((video, i) => {
              const ids = demoVideos[i]?.youtubeId;
              return (
                <figure>
                  <VideoPlayer
                    youtubeId={ids ? (ids[lang] ?? ids.ro) : null}
                    title={video.title}
                    comingSoon={t.demo.comingSoon}
                    playLabel={demoT.player.play}
                  />
                  <figcaption class="mt-3">
                    <span class="block font-bold">{video.title}</span>
                    <span class="mt-1 block text-sm leading-relaxed text-graphite">{video.caption}</span>
                  </figcaption>
                </figure>
              );
            })
          }
        </div>
        {demoHref && <a href={demoHref} class="link-quiet mt-4">{t.demo.link}</a>}
      </div>
    </section>

    {/* Pricing teaser */}
    <section class="border-t border-line" data-track-section="pricing">
      <div class:list={[wrap, 'py-14 sm:py-20']}>
        <h2 class={sectionTitle}>{t.pricing.title}</h2>
        <div class="mt-8 max-w-2xl rounded-md border border-line border-l-4 border-l-wood bg-white p-6">
          <p class="text-sm font-semibold tracking-wide text-wood">{t.pricing.offerLabel}</p>
          <p class="mt-1 text-[2rem] leading-tight font-bold tracking-tight">{t.pricing.offerPrice}</p>
          <MilestoneText text={t.pricing.offerDetail} lang={lang} class="mt-1 text-base text-graphite" />
          {t.pricing.aiNote && (
            <MilestoneText text={t.pricing.aiNote} lang={lang} class="mt-4 text-sm leading-relaxed text-graphite" />
          )}
          {(t.pricing.free || t.pricing.cancel) && (
            <ul class="mt-4 space-y-1 text-sm font-medium text-ink">
              {t.pricing.free && <li>{t.pricing.free}</li>}
              {t.pricing.cancel && <li>{t.pricing.cancel}</li>}
            </ul>
          )}
        </div>
        {pricingHref && <a href={pricingHref} class="link-quiet mt-4">{t.pricing.link}</a>}
      </div>
    </section>

    {/* FAQ teaser: native <details>, no JS */}
    <section class="border-t border-line bg-white/60">
      <div class:list={[wrap, 'py-14 sm:py-20']}>
        <h2 class={sectionTitle}>{t.faq.title}</h2>
        <div class="mt-8 max-w-2xl divide-y divide-line border-y border-line">
          {
            t.faq.items.map((item) => (
              <details class="group py-1">
                <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
                  {item.q}
                  <span class="text-xl font-normal text-wood transition-transform group-open:rotate-45" aria-hidden="true">
                    +
                  </span>
                </summary>
                <MilestoneText text={item.a} lang={lang} class="pb-4 text-base leading-relaxed text-graphite" />
              </details>
            ))
          }
        </div>
        {faqHref && <a href={faqHref} class="link-quiet mt-4">{t.faq.link}</a>}
      </div>
    </section>

    {/* Final CTA: title full-width; app/FP left, news signup right (joinFreeHref lands here) */}
    <section id={joinId} class="scroll-mt-4 border-t border-line">
      <div class:list={[wrap, 'py-14 sm:py-24']}>
        <h2 class:list={[sectionTitle, 'max-w-3xl text-balance']}>{t.final.title}</h2>
        <div class="mt-10 grid gap-12 lg:grid-cols-2 lg:gap-16 lg:items-start">
          <div class="flex flex-col items-stretch gap-4 sm:max-w-md">
            <a href={APP_URL} class="btn-primary" data-cta="open_app" data-cta-location="final" rel="noopener">
              {t.hero.ctaPrimary}
            </a>
            {
              fpHref && (
                <>
                  <p class="text-base font-medium text-graphite">{t.final.or}</p>
                  <a href={fpHref} class="btn-secondary" data-cta="founding_partner" data-cta-location="final">
                    {t.hero.ctaSecondary}
                  </a>
                </>
              )
            }
          </div>
          <div class="lg:border-l lg:border-line lg:pl-16">
            <p class="mb-4 text-base font-medium text-graphite">{t.final.news}</p>
            <NewsletterForm lang={lang} t={formT} privacyHref={privacyHref} />
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} preview={preview} />
</Base>

<script>
  // Funnel event (Build Brief Section 5): how far down the page visitors get.
  // Button clicks are tracked site-wide by src/components/CtaTracking.astro.
  type Plausible = (event: string, options?: { props?: Record<string, string> }) => void;
  const track: Plausible = (event, options) => (window as unknown as { plausible?: Plausible }).plausible?.(event, options);

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        track('landing_scroll_depth', { props: { section: (entry.target as HTMLElement).dataset.trackSection ?? '' } });
        observer.unobserve(entry.target);
      }
    },
    { threshold: 0.4 },
  );
  document.querySelectorAll('[data-track-section]').forEach((section) => observer.observe(section));
</script>
