---
// Founding Partner program page (Build Brief 4.2, Funnel Plan 3.2).
// Until Stripe exists, "claim your spot" is a reservation without payment:
// it adds the person to a Brevo list, which also drives the spot counter.
import Base from '../layouts/Base.astro';
import FoundingPartnerForm from './FoundingPartnerForm.astro';
import PreviewBanner from './PreviewBanner.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { testimonials } from '../data/testimonials';
import { useFoundingPartnerTranslations, type Lang } from '../i18n';
import { joinFreeHref as joinFree, linkFor, pathsFor, published } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const preview = !published.foundingPartner;
const t = useFoundingPartnerTranslations(lang);
const paths = pathsFor('foundingPartner');
const joinFreeHref = joinFree(lang, preview);
// The full policy is required before this page is published (src/site.ts).
const privacyHref = linkFor('privacy', lang, preview) ?? '';
const reserveId = lang === 'ro' ? 'rezervare' : 'reserve';
const quotes = testimonials[lang];
const wrap = 'mx-auto w-full max-w-5xl px-5 sm:px-8';
const sectionTitle = 'text-[1.625rem] leading-tight font-bold tracking-tight sm:text-[2rem]';
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} alternates={preview ? undefined : paths}>
  {preview && <PreviewBanner lang={lang} />}

  <div class={wrap}>
    <SiteHeader lang={lang} alternates={paths} preview={preview} current="foundingPartner" />
  </div>

  <main>
    {/* Hero */}
    <section class:list={[wrap, 'pt-10 pb-16 sm:pt-16 sm:pb-24']}>
      <div class="max-w-2xl">
        <div class="dimension-line mb-6" aria-hidden="true"></div>
        <p class="text-sm font-semibold tracking-wide text-wood">{t.hero.label}</p>
        <h1 class="mt-3 text-[2rem] leading-[1.12] font-bold tracking-tight text-balance sm:text-[3rem]">{t.hero.title}</h1>
        <p class="mt-5 text-lg leading-relaxed text-graphite">{t.hero.body}</p>
        <p
          data-fp-counter
          data-template-remaining={t.counter.remaining}
          data-template-full={t.counter.full}
          hidden
          class="mt-6 inline-flex items-center gap-2 rounded-full border border-line bg-white px-4 py-1.5 text-sm font-semibold text-ink"
        >
        </p>
        <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-6">
          <a href={`#${reserveId}`} class="btn-primary" data-cta="founding_partner" data-cta-location="fp_hero">{t.hero.cta}</a>
          <a href={joinFreeHref} class="link-quiet" data-cta="join_free" data-cta-location="fp_hero">{t.joinFree}</a>
        </div>
      </div>
    </section>

    {/* What's included */}
    <section class="border-t border-line bg-white/60">
      <div class:list={[wrap, 'py-14 sm:py-20']}>
        <h2 class={sectionTitle}>{t.included.title}</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            t.included.items.map((item) => (
              <li class="rounded-md border border-line bg-white p-5">
                <h3 class="text-lg font-bold tracking-tight">{item.title}</h3>
                <p class="mt-2 text-base leading-relaxed text-graphite">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* The offer, and what Basic doesn't include (stated up front, Build Brief 4.2) */}
    <section class="border-t border-line">
      <div class:list={[wrap, 'grid gap-6 py-14 sm:py-20 md:grid-cols-2']}>
        <div class="rounded-md border border-line border-l-4 border-l-wood bg-white p-6">
          <h2 class="text-sm font-semibold tracking-wide text-wood">{t.offer.title}</h2>
          <p class="mt-2 text-[2.25rem] leading-tight font-bold tracking-tight">{t.offer.price}</p>
          <p class="text-lg font-semibold text-graphite">{t.offer.yearly}</p>
          <p class="mt-3 text-base leading-relaxed text-graphite">{t.offer.detail}</p>
          <p class="mt-4 text-sm font-medium text-ink">{t.offer.noPayment}</p>
        </div>
        <div class="rounded-md border border-line bg-white p-6">
          <h2 class="text-lg font-bold tracking-tight">{t.ai.title}</h2>
          <p class="mt-3 text-base leading-relaxed text-graphite">{t.ai.body}</p>
        </div>
      </div>
    </section>

    {/* Social proof: structure only; hidden until real quotes are in src/data/testimonials.ts */}
    {
      quotes.length > 0 && (
        <section class="border-t border-line bg-white/60">
          <div class:list={[wrap, 'py-14 sm:py-20']}>
            <h2 class={sectionTitle}>{t.proof.title}</h2>
            <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {quotes.map((q) => (
                <figure class="rounded-md border border-line bg-white p-5">
                  <blockquote class="text-base leading-relaxed text-ink">„{q.quote}”</blockquote>
                  <figcaption class="mt-4 text-sm text-graphite">
                    <span class="font-semibold text-ink">{q.name}</span>, {q.workshop}, {q.city}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* Reservation */}
    <section id={reserveId} class="scroll-mt-4 border-t border-line">
      <div class:list={[wrap, 'grid gap-10 py-14 sm:py-24 md:grid-cols-[3fr_2fr]']}>
        <div>
          <h2 class={sectionTitle}>{t.form.title}</h2>
          <p
            data-fp-counter
            data-template-remaining={t.counter.remaining}
            data-template-full={t.counter.full}
            hidden
            class="mt-3 text-sm font-semibold text-wood"
          >
          </p>
          <div class="mt-6">
            <FoundingPartnerForm lang={lang} t={t} privacyHref={privacyHref} />
          </div>
        </div>
        <div>
          <h3 class="text-lg font-bold tracking-tight">{t.next.title}</h3>
          <ol class="mt-4 space-y-4">
            {
              t.next.steps.map((step, i) => (
                <li class="flex gap-3 text-base leading-relaxed text-graphite">
                  <span class="flex size-7 shrink-0 items-center justify-center rounded-full border border-wood text-sm font-semibold text-wood">
                    {i + 1}
                  </span>
                  <span class="pt-0.5">{step}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} preview={preview} />
</Base>

<script>
  // Spot counter: filled from the reservation list. Stays hidden if the count
  // can't be loaded, rather than showing a made-up number.
  type Spots = { total: number; remaining: number };
  const counters = document.querySelectorAll<HTMLElement>('[data-fp-counter]');
  let spots: Spots | undefined;

  const render = () => {
    if (!spots) return;
    for (const el of counters) {
      const template = spots.remaining > 0 ? el.dataset.templateRemaining : el.dataset.templateFull;
      el.textContent = (template ?? '').replace('{remaining}', String(spots.remaining)).replace('{total}', String(spots.total));
      el.hidden = false;
    }
  };

  fetch('/api/founding-partner')
    .then((res) => (res.ok ? res.json() : Promise.reject()))
    .then((data: Spots) => {
      spots = data;
      render();
    })
    .catch(() => {});

  // The count is cached for up to a minute, so reflect a fresh reservation locally.
  document.addEventListener('fp:reserved', () => {
    if (spots && spots.remaining > 0) spots.remaining -= 1;
    render();
  });
</script>
