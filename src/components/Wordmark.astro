---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  class="inline-flex min-h-11 items-center gap-2.5 text-ink"
  aria-label="MobilCab"
>
  {/* C — Sertare: ink outline, wood accent pe mânerul din mijloc */}
  <svg
    class="size-7 shrink-0 sm:size-8"
    viewBox="0 0 36 40"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <rect x="1.25" y="1.25" width="33.5" height="37.5" rx="2.5" stroke="#1D2126" stroke-width="2.5"></rect>
    <rect x="4" y="5" width="28" height="9" rx="1" stroke="#1D2126" stroke-width="1.5"></rect>
    <rect x="14" y="8.5" width="8" height="2" fill="#1D2126"></rect>
    <rect x="4" y="15.5" width="28" height="9" rx="1" stroke="#1D2126" stroke-width="1.5"></rect>
    <rect x="14" y="19" width="8" height="2" fill="#9A5F1A"></rect>
    <rect x="4" y="26" width="28" height="9" rx="1" stroke="#1D2126" stroke-width="1.5"></rect>
    <rect x="14" y="29.5" width="8" height="2" fill="#1D2126"></rect>
  </svg>
  <span
    class="grid grid-cols-[auto_auto] grid-rows-[auto_auto] items-end gap-x-0 gap-y-1 text-[1.1875rem] leading-none font-bold tracking-tight sm:gap-y-1.5 sm:text-[1.25rem]"
  >
    <span class="text-ink">Mobil</span>
    <span class="text-wood">Cab</span>
    <span class="col-start-1 h-0.5 bg-wood sm:h-1" aria-hidden="true"></span>
  </span>
</a>
