---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a href={href} class="inline-flex min-h-11 items-center gap-2 text-ink" aria-label="Mobilcab">
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <rect x="3" y="2.5" width="18" height="19" rx="1.5"></rect>
    <path d="M12 2.5v19"></path>
    <path d="M9.25 10.5v3M14.75 10.5v3" class="stroke-wood" stroke-width="2" stroke-linecap="round"></path>
  </svg>
  <span class="text-[1.0625rem] font-semibold tracking-tight">mobilcab</span>
</a>
