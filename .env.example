# Copy to .env for local development. On Vercel, set these under
# Project Settings -> Environment Variables instead.

# Brevo -> SMTP & API -> API Keys
BREVO_API_KEY=

# Brevo -> Contacts -> Lists: the numeric ID of the waitlist list
BREVO_LIST_ID=

# Optional: a separate list for English sign-ups, so launch emails can go out
# in the right language. Leave empty to put everyone in BREVO_LIST_ID.
BREVO_LIST_ID_EN=

# Double opt-in: IDs of the two Brevo transactional templates for the
# confirmation email (emails/confirm-ro.html and confirm-en.html).
BREVO_CONFIRM_TEMPLATE_ID_RO=
BREVO_CONFIRM_TEMPLATE_ID_EN=

# Signs the confirmation links. Any long random string (e.g. 40+ characters);
# keep it secret. Changing it invalidates links that were already sent.
CONFIRM_SECRET=

# Protects the daily clean-up of unconfirmed sign-ups (/api/cleanup). Vercel
# sends it automatically with its Cron Jobs; any long random string.
CRON_SECRET=

# Brevo list for Founding Partner reservations (Phase 2). Also powers the
# "X din 100 locuri rămase" counter. Needs the WORKSHOP, CITY and LANGUAGE
# contact attributes to exist in Brevo (Contacts -> Settings -> Contact attributes).
BREVO_FP_LIST_ID=

# Optional: the domain as registered in Plausible (e.g. mobilcab.ro).
# Leave empty to disable analytics. Read at build time.
PUBLIC_PLAUSIBLE_DOMAIN=

# Public URL of the site, used for canonical and hreflang links.
SITE_URL=https://mobilcab.ro
