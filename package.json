{
  "name": "mobilcab-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "deploy:cron": "wrangler deploy -c cron/wrangler.jsonc",
    "cf:dns": "node scripts/cloudflare-dns.mjs",
    "cf:dns:apply": "node scripts/cloudflare-dns.mjs --apply",
    "og": "node scripts/generate-og-images.mjs",
    "emails": "node scripts/build-emails.mjs",
    "check-launch": "node scripts/launch-check.mjs",
    "test": "vitest run tests/unit",
    "test:build": "astro build && vitest run tests/build",
    "test:all": "npm test && npm run test:build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "vitest": "^5.0.3",
    "wrangler": "^4.157.0"
  }
}
