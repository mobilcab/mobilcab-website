# Security headers for every static response.
#
# These were in src/integrations/security-headers.mjs on Vercel, which rewrote
# .vercel/output/config.json. On Cloudflare Workers the file is read straight
# from the asset store, so it is plain configuration instead of build code.
#
# The Content-Security-Policy with the script hashes is still a <meta> tag that
# Astro emits (security.csp in astro.config.mjs); `frame-ancestors` cannot be set
# from a <meta> tag, so it is sent here as a second, header-only policy.
#
# Note: these rules do NOT apply to responses generated by the Worker (the
# /api/* routes), only to assets served from the asset store.

/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000

# Astro fingerprints every filename under /_astro/ with a content hash, so the
# browser may keep them forever. Everything else stays "revalidate every time"
# (Cloudflare's default), which is what the pages need.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
